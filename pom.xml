<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.jarrunner</groupId>
  <artifactId>teavm-native-check</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>teavm-native-check</name>

  <description>A javac plugin that turns the native-memory rules of a TeaVM C-backend project (pointers do not outlive their scope, no Address.ofData, scoped allocation, raw access only where marked) into compile errors. Compile time only: it adds nothing to the program it checks. No dependencies beyond the JDK's own jdk.compiler API.</description>
  <url>https://github.com/jarrunner/teavm-native-check</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>jarrunner</id>
      <name>Ivan Velikanov</name>
      <email>ivan.velikanov.dev@gmail.com</email>
      <url>https://github.com/jarrunner</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git://github.com/jarrunner/teavm-native-check.git</connection>
    <developerConnection>scm:git:ssh://github.com:jarrunner/teavm-native-check.git</developerConnection>
    <url>https://github.com/jarrunner/teavm-native-check</url>
  </scm>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
        <configuration>
          <!-- An empty processor path. Otherwise javac 25 looks for plugins on the classpath, finds this plugin's own
               service file in target/classes, and instantiates it (to ask autoStart()) before it is compiled. -->
          <compilerArgs>
            <arg>-processorpath</arg>
            <arg>${project.build.directory}/no-processors</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
    </plugins>
  </build>

  <!-- Release to Maven Central (Maven 3, from Git Bash so its gpg signs): mvn clean deploy -Dorg.name=jarrunner -->
    <profiles>
    <profile>
      <id>release</id>
      <activation>
        <property><name>org.name</name></property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <configuration>
              <excludeResources>true</excludeResources>
            </configuration>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.6.3</version>
            <configuration>
              <doclint>none</doclint>
              <additionalOptions>--no-fonts</additionalOptions>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
            <configuration>
              <keyname>${org.gpg.keyname}</keyname>
              <passphrase>${org.gpg.passphrase}</passphrase>
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.9.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>${org.publishing.server.id}</publishingServerId>
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
